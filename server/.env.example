# Copy to server/.env (never commit .env). Choose ONE provider.
# Put comments on their own line (like this one), not after a value.

# kindwise = dedicated mushroom classifier (recommended); anthropic = general vision LLM (never reported as "likely")
MUSHROOM_PROVIDER=kindwise

# Key from https://admin.kindwise.com (separate key per product: Mushroom.id)
KINDWISE_API_KEY=

# Only if MUSHROOM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

PORT=8787

# Optional. By default the server serves ../docs if it exists, otherwise ../src.
# STATIC_DIR=../src

# Only if the SPA is hosted on a different origin (e.g. GitHub Pages)
# ALLOWED_ORIGINS=https://<user>.github.io

# Set to 1 only when running behind a reverse proxy that sets X-Forwarded-For
# TRUST_PROXY=1
# MAX_IMAGE_BYTES=6291456
# RATE_LIMIT_PER_MIN=10
