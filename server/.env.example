# Copy to server/.env (never commit .env). Choose ONE provider.
MUSHROOM_PROVIDER=kindwise          # kindwise (dedicated mushroom classifier) | anthropic (general vision LLM, lower reliability)
KINDWISE_API_KEY=                   # from https://admin.kindwise.com (separate key per product: Mushroom.id)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=8787
STATIC_DIR=../docs                  # optional: serve the SPA from the same server (same-origin /api)
# ALLOWED_ORIGINS=https://<user>.github.io   # only if the SPA is hosted on a different origin
# MAX_IMAGE_BYTES=6291456
# RATE_LIMIT_PER_MIN=10
